# PRAMANA: minimal local configuration. Never commit your populated .env.
# Add one Google API key, then run run.cmd (Windows) or sh run.sh (macOS/Linux).
# Process environment values take precedence over this file.
GOOGLE_API_KEY=

# Optional backup provider. Leave blank if you only use Google.
GROQ_API_KEY=

# Optional settings; these defaults run the entire local demo pipeline.
PRAMANA_PORT=8765
# auto = Google API embeddings when a Google key exists, otherwise sparse search.
# false disables embeddings. Explicit --offline is required for fixture mode.
PRAMANA_SEMANTIC=auto
PRAMANA_CACHE_DIR=data/cache/generations
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false

# Romanised Hindi/Tamil questions get one extra model call that rewrites them
# into native script for retrieval. Set false to search them as typed.
# PRAMANA_TRANSLITERATE_QUERIES=true
# Optional local multilingual reranker (needs .[nlp] and a model download):
# PRAMANA_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# json = one JSON log line per event, carrying the request id.
# PRAMANA_LOG_FORMAT=text

# Live APIs consume provider quota and may incur charges.
# Use approved or fictional documents: questions/document text may be sent to APIs.
# Advanced provider/pilot configuration: docs/10_LLM_INTEGRATION.md and
# .env.pilot.example. This local launcher is NOT a public production deployment.

# Public demo (scripts/serve_demo.py --public; see docs/DEPLOYMENT.md). On Render
# these come from render.yaml; set them here only to rehearse public mode locally.
# PRAMANA_PUBLIC_HOST=localhost
# PRAMANA_VISITOR_LIMIT=10
# PRAMANA_DAILY_LIMIT=150
