# Copy to .env.pilot; never commit the populated file.
PRAMANA_MODE=pilot
# Explicit request Host allowlist. Add your TLS proxy hostname when deploying.
PRAMANA_TRUSTED_HOSTS=127.0.0.1,localhost,::1
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PRAMANA_API_KEY=
# Explicit allowlist of approved generation/verification destinations.
PRAMANA_PROVIDERS=
# Set credentials for only those providers; a custom registry can point at local servers.
GROQ_API_KEY=
GOOGLE_API_KEY=
PRAMANA_LANGUAGES=en,hi,ta
PRAMANA_OFFLINE=false
PRAMANA_CACHE_ENABLED=false
PRAMANA_EXPOSE_CORPUS=false
PRAMANA_MAX_CONCURRENT=1
PRAMANA_MAX_BODY_BYTES=32768
PRAMANA_MAX_CORRECTIONS=2
PRAMANA_MAX_PROVIDER_CALLS=32
PRAMANA_REQUEST_BUDGET_S=60
PRAMANA_PROVIDER_TIMEOUT_S=20
PRAMANA_PROVIDER_RETRIES=0
PRAMANA_VERIFIER=llm
# Optional paths inside the container; mount these read-only when configured.
PRAMANA_PROVIDER_CONFIG=
PRAMANA_CONFIDENCE_MODEL=
# Optional multilingual SentenceTransformer model directory (requires [nlp]).
PRAMANA_DENSE_MODEL=
# API semantic search, no local model. Requires Google in the provider allowlist.
PRAMANA_API_EMBEDDING_MODEL=
